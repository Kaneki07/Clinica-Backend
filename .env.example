# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Base de datos (PostgreSQL)
# En Render usa la Connection String de tu base de datos
# (Internal Database URL si el backend y la base están en Render).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/clinica?schema=public"

# JWT y cookie de sesión
# En producción genera un secreto largo y aleatorio, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="clinica_token"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Origen(es) permitidos por CORS, separados por coma.
# En producción usa exactamente el dominio del frontend, sin "/" al final.
CORS_ORIGIN="http://localhost:4321"

# Cuenta administrativa inicial (se crea/actualiza con npm run db:seed)
SEED_ADMIN_EMAIL="admin@clinica.hidalgo"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_ADMIN_NAME="Lucía"
SEED_ADMIN_LASTNAME="Herrera"
SEED_ADMIN_CI="12345678"

# Producción con frontend y backend en dominios distintos:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE="none"
