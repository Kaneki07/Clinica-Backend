# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Base de datos (SQLite por defecto)
# La ruta es relativa a prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# JWT y cookie de sesión
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"
COOKIE_NAME="clinica_token"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:4321"

# Cuenta administrativa inicial (se crea/actualiza con npm run db:seed)
SEED_ADMIN_EMAIL="admin@clinica.hidalgo"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_ADMIN_NAME="Lucía"
SEED_ADMIN_LASTNAME="Herrera"
SEED_ADMIN_CI="12345678"
